# Inbound webhook receiver (see docs/BACKEND_API.md "Inbound webhook
# receiver"). REQUIRED in production — an unset key fails OPEN (skips
# signature verification). Generate with: openssl rand -hex 32, store in the
# Creytix vault, set on Vercel praxiumlaw-back, never commit the real value.
GENERIC_WEBHOOK_KEY=change-me-long-random
SENDGRID_WEBHOOK_KEY=
MAILGUN_SIGNING_KEY=
