DB_NAME=praxium_prod
JWT_SECRET=change-me-long-random
CORS_ORIGINS=https://www.praxiumlaw.com,https://praxiumlaw.com,https://www.praxahq.com,https://praxahq.com,https://www.praxiumsuite.com,https://praxiumsuite.com,https://praxiumlaw-front.vercel.app
