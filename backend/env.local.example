# Copy to backend/.env (gitignored): cp env.local.example .env
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=praxium_dev
JWT_SECRET=praxium-dev-secret-change-in-prod
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional — AI chat (requires emergentintegrations in Emergent pod)
EMERGENT_LLM_KEY=
# Identity verification (face scan + ID)
PRAXIUM_FRONTEND_URL=http://localhost:3000
PRAXIUM_IDV_DEMO_ENABLED=true
PRAXIUM_IDV_TOKEN_TTL_HOURS=168
# Client portal (magic-link login — no client passwords)
PRAXIUM_PORTAL_LINK_TTL_HOURS=24
PRAXIUM_PORTAL_SESSION_DAYS=7
# Dev only: return verify URLs in API responses (never enable in production)
PRAXIUM_PORTAL_DEV_RETURN_LINK=true
# Transactional email (Resend) — portal invites, upload links, NativeSign
RESEND_API_KEY=
PRAXIUM_EMAIL_FROM=Praxium Suite <onboarding@resend.dev>
# NativeSign magic-link TTL (days)
PRAXIUM_SIGN_LINK_TTL_DAYS=14
